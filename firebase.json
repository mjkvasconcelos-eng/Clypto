{
  "functions": { "source": "functions" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "southamerica-east1" } }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
